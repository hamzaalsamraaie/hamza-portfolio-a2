<%- include('partials/header') %>

<!-- ======================================
     About Me - Introduction
     ====================================== -->

<section class="mb-5">

  <p class="text-uppercase fw-bold mb-2"
     style="color: var(--portfolio-teal);">
    Get to Know Me
  </p>

  <h1 class="display-5 fw-bold mb-4">
    About Me
  </h1>

  <p class="lead">
    Hi, I'm Hamza Al-Samraaie, an Information
    Technology student specializing in Networking
    and IT Security at Ontario Tech University.
  </p>

  <p>
    I enjoy exploring cybersecurity, networking,
    and software development. I am especially
    interested in building security-related projects
    and understanding how technology can be
    designed and protected.
  </p>

  <p>
    My goal is to develop my technical knowledge
    through education, practical projects, and
    continued learning in cybersecurity.
  </p>

</section>

<!-- ======================================
     Education and Certification
     ====================================== -->

<section class="mb-5"
         aria-labelledby="background-heading">

  <h2 id="background-heading" class="h3 mb-4">
    Education &amp; Certification
  </h2>

  <div class="row g-4">

    <!-- Education information -->
    <div class="col-md-6">

      <article class="card h-100 shadow-sm">

        <div class="card-body p-4">

          <i class="fa-solid fa-graduation-cap fa-2x mb-3"
             style="color: var(--portfolio-teal);"></i>

          <h3 class="card-title h5">
            Education
          </h3>

          <p class="fw-semibold mb-2">
            Ontario Tech University
          </p>

          <p class="card-text">
            Bachelor of Information Technology
            (Honours), specializing in
            Networking and IT Security.
          </p>

        </div>
      </article>

    </div>

    <!-- Certification information -->
    <div class="col-md-6">

      <article class="card h-100 shadow-sm">

        <div class="card-body p-4">

          <i class="fa-solid fa-award fa-2x mb-3"
             style="color: var(--portfolio-teal);"></i>

          <h3 class="card-title h5">
            Certification
          </h3>

          <p class="fw-semibold mb-2">
            CompTIA Security+
          </p>

          <p class="card-text">
            I have earned the CompTIA Security+
            certification, supporting my knowledge
            of cybersecurity fundamentals,
            security operations, and risk management.
          </p>

        </div>
      </article>

    </div>

  </div>

</section>

<!-- ======================================
     Technical Skills
     ====================================== -->

<section class="mb-5"
         aria-labelledby="skills-heading">

  <h2 id="skills-heading" class="h3 mb-4">
    Technical Skills
  </h2>

  <div class="row g-4">

    <!-- Networking skills -->
    <div class="col-md-6">

      <article class="card h-100 shadow-sm">

        <div class="card-body p-4">

          <i class="fa-solid fa-network-wired fa-2x mb-3"
             style="color: var(--portfolio-teal);"></i>

          <h3 class="card-title h5">
            Networking &amp; Security
          </h3>

          <ul class="mb-0">
            <li>TCP/IP and network fundamentals</li>
            <li>Routing and switching</li>
            <li>Network security</li>
            <li>Firewalls and access control</li>
            <li>Security fundamentals</li>
          </ul>

        </div>
      </article>

    </div>

    <!-- Programming skills -->
    <div class="col-md-6">

      <article class="card h-100 shadow-sm">

        <div class="card-body p-4">

          <i class="fa-solid fa-laptop-code fa-2x mb-3"
             style="color: var(--portfolio-teal);"></i>

          <h3 class="card-title h5">
            Programming &amp; Development
          </h3>

          <ul class="mb-0">
            <li>Python</li>
            <li>JavaScript</li>
            <li>HTML and CSS</li>
            <li>Node.js and Express.js</li>
            <li>Git and GitHub</li>
          </ul>

        </div>
      </article>

    </div>

  </div>

</section>

<!-- ======================================
     Interests and Career Goals
     ====================================== -->

<section class="mb-5"
         aria-labelledby="interests-heading">

  <h2 id="interests-heading" class="h3 mb-4">
    Interests &amp; Career Goals
  </h2>

  <div class="card shadow-sm">

    <div class="card-body p-4">

      <i class="fa-solid fa-bullseye fa-2x mb-3"
         style="color: var(--portfolio-teal);"></i>

      <h3 class="card-title h5">
        My Cybersecurity Journey
      </h3>

      <p class="card-text">
        I am interested in cybersecurity,
        network infrastructure, and the
        security challenges introduced by
        emerging technologies such as AI.
      </p>

      <p class="card-text">
        Outside of my coursework, I enjoy
        working on technical projects and
        improving my practical skills.
        My long-term goal is to build a
        career in cybersecurity.
      </p>

      <a href="/projects" class="btn btn-primary">
        <i class="fa-solid fa-code me-2"></i>
        View My Projects
      </a>

    </div>
  </div>

</section>

<!-- ======================================
     Contact Call to Action
     ====================================== -->

<section class="text-center mb-4"
         aria-labelledby="connect-heading">

  <h2 id="connect-heading" class="h3 mb-3">
    Let's Connect
  </h2>

  <p>
    Interested in my work or want to connect?
    Visit my contact page.
  </p>

  <a href="/contact"
     class="btn btn-outline-primary btn-lg">

    <i class="fa-solid fa-envelope me-2"></i>
    Contact Me

  </a>

</section>

